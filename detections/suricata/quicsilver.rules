# =====================================================================================================
#  Operation QUICSILVER / QUICAgent - Suricata 7 rules - ANCHOR - TLP:CLEAR - 2026-10-15
#  https://github.com/yankywilson/quicsilver-quicagent-cti
#  sid range 1913001-1913999 (local). Generated from iocs/iocs.csv by tools/build_exports.py - do not edit.
#  QUICAgent speaks HTTP/3 over QUIC: quic.sni reads the C2 name from the client Initial (Suricata decrypts Initials with keys from the public DCID).
#  Rules tagged 'historic' match infrastructure the actor has since abandoned - use for retro-hunts only.
# =====================================================================================================
# --- Section A: DNS, TLS SNI and QUIC SNI ---
alert dns $HOME_NET any -> any any (msg:"ANCHOR QUICSILVER DNS www .maui-cocktailbar .com (historic)"; dns.query; dotprefix; content:".www.maui-cocktailbar.com"; nocase; endswith; reference:url,github.com/yankywilson/quicsilver-quicagent-cti; classtype:trojan-activity; sid:1913001; rev:1; metadata:created_at 2026_10_15, updated_at 2026_10_15, tag QUICSILVER, tag QUICAgent, tag TLP_CLEAR;)
